# ---------------------------------------------------------------------------
# InfoHub – variáveis de ambiente
# Copie para .env (local) ou cadastre no Coolify (produção). Nunca commite o .env.
# ---------------------------------------------------------------------------

# ===== Servidor =====
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# URL pública do sistema (usada nos links dos e-mails)
APP_URL=http://localhost:3000

# ===== Banco de dados =====
# IMPORTANTE: o PostgreSQL da faculdade é compartilhado entre as duplas — cada grupo
# trabalha no SEU schema. O `?schema=` é obrigatório (nunca use `public`).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/infohub?schema=infohub_losekann

# ===== Autenticação (RF-01) =====
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-em-producao-com-no-minimo-32-caracteres
JWT_EXPIRES_IN_MINUTES=15
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
PASSWORD_RESET_EXPIRES_IN_MINUTES=60
# Validade, em horas, do link de ativação (integrante cadastrado pelo líder, RF-02)
# e do link de confirmação do e-mail (líder que se cadastra com senha)
ACTIVATION_EXPIRES_IN_HOURS=72
BCRYPT_ROUNDS=10

# ===== Arquivos das entregas (RF-14, RNF-04) =====
# No Coolify, monte um volume persistente nesta pasta (/app/uploads)
UPLOADS_DIR=uploads
UPLOAD_MAX_MB=50
UPLOAD_MAX_FILES=5

# ===== E-mail (RF-18/19, RNF-06) =====
# console = só imprime no terminal | smtp = servidor SMTP (Gmail/Outlook da faculdade) | resend = API Resend
MAIL_DRIVER=console
# Remetente. Com a Resend, o domínio precisa estar verificado em resend.com/domains. Sem domínio
# próprio, use "InfoHub <onboarding@resend.dev>" — modo de teste: só entrega para o e-mail da sua conta Resend.
MAIL_FROM="InfoHub <nao-responda@infohub.amf.edu.br>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# resend.com/api-keys (começa com re_; a permissão "Sending access" basta)
RESEND_API_KEY=
# Quantas vezes tentar reenviar um e-mail que falhou
MAIL_MAX_ATTEMPTS=5

# ===== Rotina agendada (RN-04, RF-17, RNF-06) =====
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=10

# ===== Retenção de dados pessoais (RNF-02, docs/lgpd.md) — em dias; 0 desliga =====
RETENTION_SESSIONS_DAYS=30
RETENTION_TOKENS_DAYS=30
RETENTION_NOTIFICATIONS_DAYS=365
RETENTION_ACCESS_LOG_DAYS=180

# ===== Backup (RNF-07) =====
# A rotina agendada grava um backup do schema + os arquivos das entregas a cada
# BACKUP_INTERVAL_HOURS e guarda os BACKUP_KEEP mais novos. No Dockerfile já vem ligado
# (BACKUP_DIR=/app/backups — monte um volume persistente nessa pasta no Coolify).
BACKUP_ENABLED=false
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# ===== Seed (roda em todo deploy: npm start → db:preparar) =====
# Conta de administrador criada pelo seed (troque a senha em produção!)
SEED_ADMIN_NOME=Administrador InfoHub
SEED_ADMIN_EMAIL=admin@infohub.amf.edu.br
SEED_ADMIN_SENHA=Admin@123
# Cenário de demonstração da G1 (3 equipes, 4 mentores, 2 na etapa 2, 1 tarefa atrasada).
# É criado por padrão; SEED_DEMO=false desliga.
SEED_DEMO=true
