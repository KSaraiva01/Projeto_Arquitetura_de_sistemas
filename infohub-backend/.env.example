# ===== Servidor =====
NODE_ENV=development
PORT=3333
API_PREFIX=/api

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== Banco de dados =====
# Opção 1 (padrão): variáveis separadas, para PostgreSQL instalado localmente
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=infohub
DATABASE_SSL=false

# Opção 2: URL completa. Quando definida, tem prioridade sobre as variáveis acima.
# DATABASE_URL=postgresql://postgres:senha@localhost:5432/infohub

# ===== Autenticação =====
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-em-producao-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
PASSWORD_RESET_EXPIRES_IN_MINUTES=60
BCRYPT_SALT_ROUNDS=10

# ===== E-mail (RNF-06) =====
# console = apenas imprime no terminal (desenvolvimento) | resend = envio real
MAIL_DRIVER=console
MAIL_FROM="InfoHub <nao-responda@infohub.amf.edu.br>"
RESEND_API_KEY=

# URL do frontend, usada nos links dos e-mails
APP_URL=http://localhost:3000


